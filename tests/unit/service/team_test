type MockTx struct {
	mock.Mock
}

func (m *MockTx) Exec(ctx context.Context, sql string, args ...any) (pgx.CommandTag, error) {
	args2 := m.Called(ctx, sql, args)
	return args2.Get(0).(pgx.CommandTag), args2.Error(1)
}

func (m *MockTx) QueryRow(ctx context.Context, sql string, args ...any) pgx.Row {
	args2 := m.Called(ctx, sql, args)
	return args2.Get(0).(pgx.Row)
}

func (m *MockTx) Commit(ctx context.Context) error {
	return m.Called(ctx).Error(0)
}

func (m *MockTx) Rollback(ctx context.Context) error {
	return m.Called(ctx).Error(0)
}

type MockPool struct {
	mock.Mock
}

func (m *MockPool) BeginTx(ctx context.Context, opts pgx.TxOptions) (pgx.Tx, error) {
	args := m.Called(ctx, opts)
	return args.Get(0).(pgx.Tx), args.Error(1)
}

// Мок для QueryRow (псевдо-Row)
type MockRow struct {
	mock.Mock
}

func (r *MockRow) Scan(dest ...any) error {
	args := r.Called(dest)
	return args.Error(0)
}

// =====================
// Тест CreateTeam
// =====================
func TestCreateTeam_Success(t *testing.T) {
	ctx := context.Background()

	mockTx := new(MockTx)
	mockPool := new(MockPool)

	// Настройка моков
	mockPool.On("BeginTx", ctx, mock.Anything).Return(mockTx, nil)

	// Проверка команды
	mockRow := new(MockRow)
	mockRow.On("Scan", mock.Anything).Run(func(args mock.Arguments) {
		ptr := args.Get(0).(*int)
		*ptr = 0 // команда не существует
	}).Return(nil)

	mockTx.On("QueryRow", ctx, "SELECT COUNT(*) FROM users WHERE team_name = $1", mock.Anything).Return(mockRow)

	// Проверка пользователей
	mockUserRow := new(MockRow)
	mockUserRow.On("Scan", mock.Anything).Run(func(args mock.Arguments) {
		ptr := args.Get(0).(*int)
		*ptr = 0
	}).Return(nil)
	mockTx.On("QueryRow", ctx, mock.Anything, mock.Anything).Return(mockUserRow)

	// Вставка пользователей
	mockTx.On("Exec", ctx, mock.Anything, mock.Anything).Return(pgx.CommandTag{}, nil)

	// Commit
	mockTx.On("Commit", ctx).Return(nil)
	mockTx.On("Rollback", ctx).Return(nil)

	service := &domain_service.TeamService{database: &infrasctucture.PostgresDb{Pool: mockPool}}

	users := []entity.User{
		{UserID: "u1", Username: "user1", IsActive: true},
		{UserID: "u2", Username: "user2", IsActive: true},
	}

	result, err := service.CreateTeam(ctx, "team1", users)
	assert.NoError(t, err)
	assert.Len(t, result, 2)
	assert.Equal(t, "u1", result[0].UserID)
	assert.Equal(t, "team1", result[0].TeamName)
}

