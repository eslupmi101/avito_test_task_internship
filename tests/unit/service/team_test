// Тест GetTeam
// =====================
type MockRows struct {
	mock.Mock
	idx  int
	data []*entity.User
}

func (r *MockRows) Next() bool {
	if r.idx < len(r.data) {
		return true
	}
	return false
}

func (r *MockRows) Scan(dest ...any) error {
	if r.idx >= len(r.data) {
		return errors.New("no more rows")
	}
	d := r.data[r.idx]
	r.idx++
	dest[0] = &d.UserID
	dest[1] = &d.Username
	dest[2] = &d.IsActive
	dest[3] = &d.TeamName
	return nil
}

func (r *MockRows) Close() error {
	return nil
}

func TestGetTeam_Success(t *testing.T) {
	mockPool := new(MockPool)
	service := &domain_service.TeamService{database: &infrasctucture.PostgresDb{Pool: mockPool}}
	ctx := context.Background()

	mockRows := &MockRows{
		data: []*entity.User{
			{UserID: "u1", Username: "user1", IsActive: true, TeamName: "team1"},
			{UserID: "u2", Username: "user2", IsActive: true, TeamName: "team1"},
		},
	}

	mockPool.On("Query", ctx, "SELECT user_id, username, is_active, team_name FROM users WHERE team_name = $1", "team1").Return(mockRows, nil)

	result, err := service.GetTeam(ctx, "team1")
	assert.NoError(t, err)
	assert.Len(t, result, 2)
	assert.Equal(t, "u1", result[0].UserID)
}
